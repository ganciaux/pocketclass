rules_version = '2';

// PocketClass security rules.
// Model: users/{uid} is an index pointing to the user's family. Everything else lives under
// families/{familyId}. Family admins (parents, Google accounts) have full access to their
// family. Linked devices (children: anonymous accounts linked with a code from the parent) read
// the catalogue and their own profile, and write only their look, progress and notes.
// Anything not explicitly allowed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function devicePath(familyId, uid) {
      return /databases/$(database)/documents/families/$(familyId)/devices/$(uid);
    }

    // Parent with full access to the family.
    function isAdmin(familyId) {
      return signedIn() && request.auth.uid in get(familyPath(familyId)).data.admins;
    }

    // Device linked to the family (child phone).
    function isDevice(familyId) {
      return signedIn() && exists(devicePath(familyId, request.auth.uid));
    }

    function isMember(familyId) {
      return isAdmin(familyId) || isDevice(familyId);
    }

    // The profile a linked device acts as.
    function deviceProfileId(familyId) {
      return get(devicePath(familyId, request.auth.uid)).data.profileId;
    }

    // The request only changes these fields.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Optional string field: absent, or a string of at most `max` characters.
    function optionalString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // After the batch, this device is linked to the family and profile of the index entry.
    function linkedAfter(index) {
      return getAfter(devicePath(index.familyId, request.auth.uid)).data.profileId == index.profileId;
    }

    // Index document: a user reads their own entry. A parent creates { familyId: uid,
    // profileId: uid }. A child device writes it in the link batch, once its device entry
    // exists after the batch, and may rewrite it when linked again.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId', 'profileId'])
        && ((request.resource.data.familyId == uid && request.resource.data.profileId == uid)
          || linkedAfter(request.resource.data));
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId', 'profileId'])
        && linkedAfter(request.resource.data);
    }

    // Device link codes (parent → child). Read one by one only (no listing), while valid.
    // Deleted by the admin, or by the device it linked (in the link batch).
    match /linkCodes/{code} {
      allow get: if signedIn() && (resource == null || request.time < resource.data.expiresAt);
      allow create: if isAdmin(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId', 'profileId', 'expiresAt'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(15, 'm');
      allow delete: if isAdmin(resource.data.familyId)
        || getAfter(devicePath(resource.data.familyId, request.auth.uid)).data.code == code;
    }

    match /families/{familyId} {
      // A parent (not an anonymous child account) may create only their own family
      // (id = their uid), as sole admin.
      allow create: if signedIn()
        && !isAnonymous()
        && familyId == request.auth.uid
        && request.resource.data.admins == [request.auth.uid];
      allow read: if isMember(familyId);
      allow update, delete: if isAdmin(familyId);

      // Admins: read and write everything under their family.
      match /{document=**} {
        allow read, write: if isAdmin(familyId);
      }

      // Members: read the catalogue.
      match /subjects/{subjectId} {
        allow read: if isMember(familyId);
      }
      match /chapters/{chapterId} {
        allow read: if isMember(familyId);
      }
      match /concepts/{conceptId} {
        allow read: if isMember(familyId);

        match /exercises/{exerciseId} {
          allow read: if isMember(familyId);
        }
        // Pictures of the mind map, added by the parent (written through the admin rule).
        match /mapImages/{imageId} {
          allow read: if isMember(familyId);
        }
      }
      match /assessments/{assessmentId} {
        allow read: if isMember(familyId);
      }

      // Devices: read and delete (unlink) their own entry; create it with a valid code for
      // this family and profile (the code as it is before the link batch), which the same
      // batch must delete: a code links one device only.
      match /devices/{uid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['profileId', 'code', 'linkedAt'])
          && validCode(familyId, request.resource.data.code, request.resource.data.profileId)
          && !existsAfter(/databases/$(database)/documents/linkCodes/$(request.resource.data.code));
      }

      // Linked devices: read their own profile and its subcollections (progress, notes...),
      // and write only what the child owns (not `extraSubjects`, set by the parent).
      match /profiles/{profileId} {
        allow read: if isOwnDevice(familyId, profileId);
        // Look only: nickname and a small avatar data URL.
        allow update: if isOwnDevice(familyId, profileId)
          && onlyChanges(['nickname', 'avatar'])
          && optionalString(request.resource.data, 'nickname', 24)
          && optionalString(request.resource.data, 'avatar', 60000)
          && (!('avatar' in request.resource.data)
            || request.resource.data.avatar.matches('^data:image/(webp|jpeg|png);base64,.*'));
        // Points: only by the amount of a points line created in the same batch, named by
        // `lastEarningId` (so a line is counted once).
        allow update: if isOwnDevice(familyId, profileId)
          && onlyChanges(['points', 'lastEarningId'])
          && request.resource.data.lastEarningId is string
          && !exists(ledgerPath(familyId, profileId, request.resource.data.lastEarningId))
          && existsAfter(ledgerPath(familyId, profileId, request.resource.data.lastEarningId))
          && request.resource.data.points == resource.data.points
            + getAfter(ledgerPath(familyId, profileId, request.resource.data.lastEarningId)).data.amount;

        match /{document=**} {
          allow read: if isOwnDevice(familyId, profileId);
        }

        // Sheet opened / read (id = concept id), with the practice scores, the challenge record
        // and the assessment. `acquiredAt` (the « Acquise » stamp) is set by the parent, or by
        // the child's own passed assessment (`assessmentLast` at the pass rate); the child
        // never changes or removes it. `assessmentPoints` is set once, with its points line.
        match /progress/{conceptId} {
          allow create: if isOwnDevice(familyId, profileId)
            && request.resource.data.keys().hasOnly(progressKeys())
            && validProgress(familyId, profileId, conceptId)
            && (!('acquiredAt' in request.resource.data)
              || childStamp(familyId, conceptId))
            && (!('assessmentPoints' in request.resource.data)
              || pointsRecorded(familyId, profileId, conceptId))
            // A revision needs an acquired sheet: never on a new progress document.
            && !request.resource.data.keys().hasAny(revisionKeys());
          allow update: if isOwnDevice(familyId, profileId)
            && request.resource.data.keys().hasOnly(progressKeys())
            && validProgress(familyId, profileId, conceptId)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['acquiredAt'])
              || (!('acquiredAt' in resource.data) && childStamp(familyId, conceptId)))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assessmentPoints'])
              || (!('assessmentPoints' in resource.data)
                && pointsRecorded(familyId, profileId, conceptId)))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(revisionKeys())
              || revisionRecorded(familyId, profileId, conceptId));
          allow delete: if isOwnDevice(familyId, profileId) && !('acquiredAt' in resource.data);
        }

        // Points earned (phase 3): one line per sheet assessment, id `assessment-<sheet>`,
        // created once by a passed assessment, of the sheet's amount; one line per paid
        // revision, id `revision-<sheet>-<n>`, recorded by the progress document in the same
        // batch (2 points per key point).
        match /pointsLedger/{entryId} {
          allow create: if isOwnDevice(familyId, profileId)
            && request.resource.data.keys().hasOnly(['kind', 'conceptId', 'subjectId', 'chapterId',
              'amount', 'createdAt'])
            && request.resource.data.subjectId is string
            && request.resource.data.chapterId is string
            && request.resource.data.createdAt == request.time
            && ((request.resource.data.kind == 'assessment'
                && entryId == 'assessment-' + request.resource.data.conceptId
                && request.resource.data.amount == assessmentPoints(familyId, request.resource.data.conceptId)
                && passedAfter(familyId, profileId, request.resource.data.conceptId))
              || (request.resource.data.kind == 'revision'
                && revisionLine(familyId, profileId, request.resource.data.conceptId, entryId)));
        }

        // One finished practice series, challenge or assessment (history): created once, never
        // changed by the child.
        match /attempts/{attemptId} {
          allow create: if isOwnDevice(familyId, profileId)
            && request.resource.data.keys().hasOnly(['conceptId', 'subjectId', 'chapterId', 'mode',
              'correct', 'total', 'answers', 'createdAt'])
            && request.resource.data.conceptId is string
            && request.resource.data.subjectId is string
            && request.resource.data.chapterId is string
            && request.resource.data.mode in ['series', 'timed', 'assessment', 'review']
            && validScore(request.resource.data)
            && request.resource.data.answers is list
            && request.resource.data.answers.size() == request.resource.data.total
            && request.resource.data.createdAt == request.time;
        }

        // What the child found difficult (on a sheet, a chapter, a subject or free). Created
        // open; editing the text reopens it; the parent (admin) sets seen / resolved.
        match /notes/{noteId} {
          allow create: if isOwnDevice(familyId, profileId)
            && request.resource.data.keys().hasOnly(['conceptId', 'chapterId', 'subjectId',
              'exerciseId', 'text', 'status', 'createdAt', 'updatedAt'])
            && nullableId(request.resource.data, 'conceptId')
            && nullableId(request.resource.data, 'chapterId')
            && nullableId(request.resource.data, 'subjectId')
            && validNoteText();
          allow update: if isOwnDevice(familyId, profileId)
            && onlyChanges(['text', 'status', 'updatedAt'])
            && validNoteText();
          allow delete: if isOwnDevice(familyId, profileId);
        }
      }
    }

    function validCode(familyId, code, profileId) {
      let link = get(/databases/$(database)/documents/linkCodes/$(code)).data;
      // The profile must still exist (it may be deleted while a code is pending) and be a child.
      return link.familyId == familyId
        && link.profileId == profileId
        && request.time < link.expiresAt
        && get(/databases/$(database)/documents/families/$(familyId)/profiles/$(profileId)).data.role == 'child';
    }

    function isOwnDevice(familyId, profileId) {
      return isDevice(familyId) && deviceProfileId(familyId) == profileId;
    }

    // A note is about a sheet, a chapter, a subject or nothing (free note): each id is a
    // string, null, or absent (older notes have no `subjectId`).
    function nullableId(data, field) {
      return data.get(field, null) == null || data.get(field, null) is string;
    }

    // A practice score: 0 <= correct <= total <= 100.
    function validScore(score) {
      return score.correct is int && score.total is int
        && score.correct >= 0 && score.correct <= score.total && score.total <= 100;
    }

    function optionalScore(data, field) {
      return !(field in data)
        || (data[field] is map && data[field].keys().hasOnly(['correct', 'total'])
          && validScore(data[field]));
    }

    function progressKeys() {
      return ['subjectId', 'chapterId', 'openedAt', 'readAt', 'acquiredAt',
        'practiceLast', 'practiceBest', 'practicedAt', 'challengeBest', 'challengedAt',
        'assessmentLast', 'assessmentBest', 'assessedAt', 'failedAt', 'retakeLocked',
        'assessmentPoints', 'mapDrawn', 'openCount', 'seriesStarted', 'challengeStarted',
        'assessmentStarted', 'revisedAt', 'revisionCount', 'revisionPoints'];
    }

    function revisionKeys() {
      return ['revisedAt', 'revisionCount', 'revisionPoints'];
    }

    function progressPath(familyId, profileId, conceptId) {
      return /databases/$(database)/documents/families/$(familyId)/profiles/$(profileId)/progress/$(conceptId);
    }

    // A paid revision (on update): the sheet is acquired, a week has gone by since the last
    // one, this write records a series at 70 % (now), and the n-th revision's points line is
    // created in the same batch; `revisionPoints` grows by its amount.
    function revisionRecorded(familyId, profileId, conceptId) {
      let after = request.resource.data;
      let count = after.get('revisionCount', 0);
      let entry = ledgerPath(familyId, profileId, 'revision-' + conceptId + '-' + string(count));
      return 'acquiredAt' in resource.data
        && count is int
        && count == resource.data.get('revisionCount', 0) + 1
        && after.get('revisedAt', null) == request.time
        && (!('revisedAt' in resource.data)
          || request.time >= resource.data.revisedAt + duration.value(7, 'd'))
        && after.get('practicedAt', null) == request.time
        && 'practiceLast' in after
        && passes(after.practiceLast, 70)
        && !exists(entry)
        && existsAfter(entry)
        && after.get('revisionPoints', 0) == resource.data.get('revisionPoints', 0)
          + getAfter(entry).data.amount;
    }

    // A revision points line: named after the revision recorded by the progress document of
    // this batch, of 2 points per key point of the sheet.
    function revisionLine(familyId, profileId, conceptId, entryId) {
      let progress = getAfter(progressPath(familyId, profileId, conceptId)).data;
      return progress.get('revisedAt', null) == request.time
        && entryId == 'revision-' + conceptId + '-' + string(progress.get('revisionCount', 0))
        && request.resource.data.amount
          == 2 * get(/databases/$(database)/documents/families/$(familyId)/concepts/$(conceptId)).data.keyPoints.size();
    }

    // Statistics counter (sheet opens, started runs): absent, unchanged or one more.
    function validCounter(field) {
      let before = resource == null ? 0 : resource.data.get(field, 0);
      let after = request.resource.data.get(field, before);
      return after is int && (after == before || after == before + 1);
    }

    function validProgress(familyId, profileId, conceptId) {
      return request.resource.data.subjectId is string
        && request.resource.data.chapterId is string
        && validPracticeScores()
        && optionalScore(request.resource.data, 'assessmentLast')
        && optionalScore(request.resource.data, 'assessmentBest')
        && request.resource.data.get('retakeLocked', false) is bool
        // Mind map « Me tester »: ids of the practice questions already drawn.
        && request.resource.data.get('mapDrawn', []) is list
        && request.resource.data.get('mapDrawn', []).size() <= 200
        && validCounter('openCount')
        && validCounter('seriesStarted')
        && validCounter('challengeStarted')
        && validCounter('assessmentStarted');
    }

    function assessmentPath(familyId, conceptId) {
      return /databases/$(database)/documents/families/$(familyId)/assessments/$(conceptId);
    }

    function ledgerPath(familyId, profileId, entryId) {
      return /databases/$(database)/documents/families/$(familyId)/profiles/$(profileId)/pointsLedger/$(entryId);
    }

    // The parent's pass rate, else 70 % (also for a sheet imported before assessments).
    function passRate(familyId, conceptId) {
      return exists(assessmentPath(familyId, conceptId))
        ? get(assessmentPath(familyId, conceptId)).data.get('passRate', 70)
        : 70;
    }

    // The parent's amount, else 10 points per key point of the sheet.
    function assessmentPoints(familyId, conceptId) {
      return exists(assessmentPath(familyId, conceptId))
          && 'points' in get(assessmentPath(familyId, conceptId)).data
        ? get(assessmentPath(familyId, conceptId)).data.points
        : 10 * get(/databases/$(database)/documents/families/$(familyId)/concepts/$(conceptId)).data.keyPoints.size();
    }

    function passes(score, rate) {
      return score.total > 0 && score.correct * 100 >= rate * score.total;
    }

    // The child stamps « Acquise » at the time of an assessment passed in this very write.
    function childStamp(familyId, conceptId) {
      return request.resource.data.acquiredAt == request.time
        && 'assessmentLast' in request.resource.data
        && passes(request.resource.data.assessmentLast, passRate(familyId, conceptId));
    }

    // The progress document after this batch records a passed assessment.
    function passedAfter(familyId, profileId, conceptId) {
      let progress = getAfter(/databases/$(database)/documents/families/$(familyId)/profiles/$(profileId)/progress/$(conceptId)).data;
      return 'assessmentLast' in progress
        && passes(progress.assessmentLast, passRate(familyId, conceptId));
    }

    // `assessmentPoints` is the amount of the sheet's points line, created in the same batch.
    function pointsRecorded(familyId, profileId, conceptId) {
      return !exists(ledgerPath(familyId, profileId, 'assessment-' + conceptId))
        && existsAfter(ledgerPath(familyId, profileId, 'assessment-' + conceptId))
        && request.resource.data.assessmentPoints
          == getAfter(ledgerPath(familyId, profileId, 'assessment-' + conceptId)).data.amount;
    }

    function validPracticeScores() {
      return optionalScore(request.resource.data, 'practiceLast')
        && optionalScore(request.resource.data, 'practiceBest')
        && (!('challengeBest' in request.resource.data)
          || (request.resource.data.challengeBest is int
            && request.resource.data.challengeBest >= 0
            && request.resource.data.challengeBest <= 100));
    }

    function validNoteText() {
      return request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open';
    }
  }
}
