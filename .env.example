# Copy to .env.local and fill in (Firebase console > Project settings > Your apps,
# or: firebase apps:sdkconfig WEB --project pocketclass-bd866)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=pocketclass-bd866.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=pocketclass-bd866
PUBLIC_FIREBASE_STORAGE_BUCKET=pocketclass-bd866.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Connect to the local Firebase Emulator Suite in dev mode (npm run emulators)
PUBLIC_USE_EMULATORS=true
