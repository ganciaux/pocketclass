{
	"name": "pocketclass",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"emulators": "firebase emulators:start",
		"build": "vite build",
		"build:emulators": "vite build --mode emulators",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest --run --project server",
		"test:watch": "vitest",
		"deploy": "npm run build && firebase deploy",
		"schemas": "node scripts/export-schemas.ts",
		"test:rules": "firebase emulators:exec --only firestore \"vitest --run --project rules\""
	},
	"devDependencies": {
		"@firebase/rules-unit-testing": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "^2.0.4",
		"jsdom": "^31.0.1",
		"magicast": "^0.5.5",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"dompurify": "^3.5.0",
		"firebase": "^13.4.0",
		"katex": "^0.19.1",
		"marked": "^18.2.1",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"@firebase/util": false,
		"protobufjs": false
	},
	"engines": {
		"node": ">=24.12"
	}
}
